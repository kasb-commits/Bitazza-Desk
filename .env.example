# Google Gemini
GEMINI_API_KEY=API_KEY
FRESHDESK_API_KEY=your_freshdesk_api_key_here
FRESHDESK_SUBDOMAIN=yourcompany.freshdesk.com

# Yellow.ai
YELLOWAI_API_KEY=your_yellowai_api_key_here
YELLOWAI_BOT_ID=your_yellowai_bot_id_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/csbot

# Vector DB
CHROMA_PATH=./data/chroma

# Auth
JWT_SECRET=your_jwt_secret_here

# User / KYC API
# Set USE_MOCK_USER_API=false and fill in the real values when going live.
# The real API requires an API key sent as a Bearer token; access is also
# restricted by IP whitelist on the provider's side.
USE_MOCK_USER_API=true
USER_API_BASE_URL=http://localhost:8000
USER_API_KEY=mock-dev-token

# Bitazza Exchange — Widget Session (auth + KYC)
# Flip USE_EXCHANGE_API=true to route auth + KYC through the real Exchange gateway
# (introspect + get-kyc). Leave the others mocked. NEVER commit the real HMAC secret.
USE_EXCHANGE_API=false
EXCHANGE_BE_BASE_URL=https://gateway.bitazza-staging.com
WIDGET_HMAC_SECRET=
WIDGET_CLIENT_ID=

# Environment — set to "production" in prod to enforce strict auth
ENV=development

# App
ESCALATION_CONFIDENCE_THRESHOLD=0.6
MAX_RAG_CHUNKS=5
RATE_LIMIT_PER_MINUTE=20

# Logging
# LOG_LEVEL controls verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_FORMAT controls output format: text (human-readable) | json (structured ndjson for Railway)
LOG_LEVEL=INFO
LOG_FORMAT=json
