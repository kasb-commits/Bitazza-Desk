{
  "name": "@bitazza/csbot-core",
  "version": "1.0.0",
  "private": true,
  "description": "Platform-agnostic core: API client, WebSocket, session, state hook, types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": ">=18",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@bitazza/csbot-core$": "<rootDir>/src/index.ts",
      "^react$": "<rootDir>/../../node_modules/react",
      "^react/jsx-runtime$": "<rootDir>/../../node_modules/react/jsx-runtime",
      "^react-dom$": "<rootDir>/../../node_modules/react-dom",
      "^react-dom/(.*)$": "<rootDir>/../../node_modules/react-dom/$1"
    }
  }
}
